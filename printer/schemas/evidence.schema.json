{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Business Lab Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "run_id",
    "observations",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "experiment_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "artifact": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "basis",
          "confidence"
        ],
        "properties": {
          "statement": {
            "type": "string"
          },
          "basis": {
            "enum": [
              "observation",
              "source",
              "inference",
              "interpretation"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "supporting_observations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
