# ===== REQUIRED =====
# Any non-empty string. Local backends (Ollama/LocalAI) ignore the auth header
# entirely, so a dummy value is fine when running against them.
OPENAI_API_KEY=

# ===== AI Backend (local-LLM / local-images support) =====
# CHAT stages (script_writer.py, seo_optimizer.py) hit OPENAI_BASE_URL.
# Leave blank for real OpenAI. For a local Ollama server:
#   OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL must be a model actually pulled locally (see `ollama list`). The
# script/SEO prompts demand strict JSON, so prefer an instruct/coder model --
# qwen2.5-coder:3B is proven to satisfy the schema reliably in e2e tests.
#   LLM_MODEL=qwen2.5-coder:3B
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o

# IMAGE stage (image_gen.py) hits IMAGE_BASE_URL - the DALL-E replacement.
# Leave blank for real DALL-E. For a local LocalAI server (same payload shape
# as OpenAI /v1/images/generations, zero adapter code):
#   IMAGE_BASE_URL=http://localhost:8080/v1
# IMAGE_MODEL must be a model in the server's registry, e.g. sdxl-turbo.
IMAGE_BASE_URL=
IMAGE_MODEL=dall-e-3

# ===== OPTIONAL: Voice Cloning (Chatterbox - local, $0) =====
# Chatterbox is Resemble AI's open-source local zero-shot voice clone (chatterbox-tts).
# Point it at a reference audio clip -- no API key needed. Used by the thee3lite channel.
CHATTERBOX_VOICE_SAMPLE_PATH=
# Per-channel override (optional; defaults to the global above):
# CHATTERBOX_VOICE_SAMPLE_PATH_THEE3LITE=
CHATTERBOX_DEVICE=cuda
CHATTERBOX_EXAGGERATION=0.5
CHATTERBOX_CFG_WEIGHT=0.5

# ===== OPTIONAL: Brand sync (marketing-ops repo) =====
# core/brand_loader.py fetches shared brand identity + CTA from the marketing-ops repo.
# GITHUB_TOKEN is needed only for private repos; public repos work without it.
GITHUB_TOKEN=

# ===== OPTIONAL: Video Modes =====
DEFAULT_VIDEO_MODE=kenburns
FINANCE_VIDEO_MODE=kenburns
MMO_VIDEO_MODE=kenburns
TECH_VIDEO_MODE=kenburns
TRENDING_VIDEO_MODE=kenburns
THEE3LITE_VIDEO_MODE=animated
LEGAL_VIDEO_MODE=kenburns
STORIES_VIDEO_MODE=kenburns
REPLICATE_API_TOKEN=

# ===== OPTIONAL: Video Quality (final 1080p encode) =====
# Lower CRF = better quality. Preset slow = max quality, higher encode time.
# Audio is upsampled/mixed to 48 kHz stereo at VIDEO_AUDIO_BITRATE.
VIDEO_CRF=16
VIDEO_PRESET=slow
VIDEO_AUDIO_BITRATE=160k
VIDEO_AUDIO_SAMPLERATE=48000
VIDEO_AUDIO_CHANNELS=2

# ===== OPTIONAL: Shorts & Music =====
GENERATE_SHORTS=false
SHORTS_PER_VIDEO=3
BACKGROUND_MUSIC=false

# ===== OPTIONAL: Upload =====
UPLOAD_MODE=local
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
PIPEDREAM_WEBHOOK_URL=
# PIPEDREAM_WEBHOOK_URL is auto-honored by stage 10 for UPLOAD_MODE=pipedream from every
# caller (orchestrator, dashboard /api/trigger, start_engine). Point it at your n8n webhook,
# e.g. http://<n8n-host>:5678/webhook/youtube-engine/upload (see n8n/README.md).
FINANCE_CHANNEL_ID=
MMO_CHANNEL_ID=
TECH_CHANNEL_ID=
TRENDING_CHANNEL_ID=
THEE3LITE_CHANNEL_ID=
LEGAL_CHANNEL_ID=
STORIES_CHANNEL_ID=

# ===== OPTIONAL: General =====
VIDEOS_PER_DAY_FINANCE=1
VIDEOS_PER_DAY_MMO=1
VIDEOS_PER_DAY_TECH=1
VIDEOS_PER_DAY_TRENDING=1
VIDEOS_PER_DAY_THEE3LITE=1
VIDEOS_PER_DAY_LEGAL=1
VIDEOS_PER_DAY_STORIES=1
LOG_LEVEL=INFO
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
CONTENT_DIR=./output

# ===== OPTIONAL: Transcript RAG =====
# Hybrid retrieval over produced videos' scripts (FTS5 + optional embeddings).
# EMBEDDINGS_BASE_URL must point at an Ollama-ish /api/embeddings endpoint;
# if the RAG_EMBEDDING_MODEL isn't installed there, search degrades to FTS-only.
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=nomic-embed-text
EMBEDDINGS_BASE_URL=http://localhost:11434
# RAG_DB_PATH=./output/rag.db

# ===== OPTIONAL: Scheduler =====
# Use per-channel cron jobs (APScheduler). Set to false to fall back to the
# PIPELINE_INTERVAL_SECONDS fixed-interval loop (orchestrator.run_forever()).
APSCHEDULER_ENABLED=true
# Interval fallback used by orchestrator.run_forever() when APScheduler
# per-channel cron jobs are disabled (see APSCHEDULER_ENABLED above).
PIPELINE_INTERVAL_SECONDS=21600
RUN_HISTORY_PATH=run_history.jsonl