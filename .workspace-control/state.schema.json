{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-control/state.schema.json",
  "title": "Workspace Continuity State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "governing_goal",
    "definition_of_done",
    "phase",
    "status",
    "active_workstream",
    "current_task",
    "completed",
    "verified",
    "in_progress",
    "blocked",
    "next_actions",
    "dependencies",
    "risks",
    "assumptions",
    "decisions",
    "artifacts",
    "relevant_files",
    "relevant_commits",
    "tests",
    "last_known_good_state",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "project": {"type": "string", "minLength": 1},
    "governing_goal": {"type": "string", "minLength": 1},
    "definition_of_done": {"type": "array", "items": {"type": "string"}},
    "phase": {"type": "string"},
    "status": {"enum": ["active", "blocked", "paused", "complete"]},
    "active_workstream": {"type": "string"},
    "current_task": {"type": "string"},
    "completed": {"type": "array", "items": {"type": "string"}},
    "verified": {"type": "array", "items": {"type": "string"}},
    "in_progress": {"type": "array", "items": {"type": "string"}},
    "blocked": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "relevant_files": {"type": "array", "items": {"type": "string"}},
    "relevant_commits": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "last_known_good_state": {"type": "string"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
