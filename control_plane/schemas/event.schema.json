{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"control-plane/event.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","event_id","run_id","sequence","timestamp","event","attempt","data"],
  "properties":{
    "schema_version":{"const":"1.0"},"event_id":{"type":"string"},"run_id":{"type":"string"},
    "sequence":{"type":"integer","minimum":1},"timestamp":{"type":"string","format":"date-time"},
    "event":{"enum":["run_created","run_started","stage_started","stage_completed","stage_failed","artifact_created","checkpoint_created","retry_scheduled","run_interrupted","recovery_started","recovery_completed","run_paused","run_resumed","run_succeeded","run_failed","run_cancelled"]},
    "stage":{"type":["string","null"]},"attempt":{"type":"integer","minimum":1},"data":{"type":"object","additionalProperties":true}
  }
}