{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"control-plane/artifact.schema.json",
  "type":"object","additionalProperties":false,
  "required":["artifact_id","run_id","stage","path","kind","created_at","sha256"],
  "properties":{
    "artifact_id":{"type":"string"},"run_id":{"type":"string"},"stage":{"type":"string"},
    "path":{"type":"string"},"kind":{"type":"string"},"created_at":{"type":"string","format":"date-time"},
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"size_bytes":{"type":"integer","minimum":0}
  }
}