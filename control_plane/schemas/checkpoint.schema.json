{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"control-plane/checkpoint.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","checkpoint_id","run_id","stage","attempt","created_at","verified","resume_from","artifacts","artifact_sha256"],
  "properties":{
    "schema_version":{"const":"1.0"},"checkpoint_id":{"type":"string"},"run_id":{"type":"string"},
    "stage":{"type":"string"},"attempt":{"type":"integer","minimum":1},"created_at":{"type":"string","format":"date-time"},
    "verified":{"const":true},"resume_from":{"type":["string","null"]},
    "artifacts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "artifact_sha256":{"type":"object","additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
  }
}
