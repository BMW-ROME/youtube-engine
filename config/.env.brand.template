# config/.env.brand.template
# Additive env template for marketing-ops brand sync.
# Copy relevant lines into your main .env (do not commit the filled .env).
#
# Fine-grained GitHub PAT with READ-ONLY access to BMW-ROME/marketing-ops.
# Required for config/brand_loader.py to fetch brand_identity.yaml live.
# If unset, brand_loader.py falls back to local cache (.brand_cache/),
# then to a minimal built-in default -- pipeline will not crash without it.
GITHUB_TOKEN=

# Optional: override the marketing-ops branch to read from (default: main)
BRAND_IDENTITY_BRANCH=main
